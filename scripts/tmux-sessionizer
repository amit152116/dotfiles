#!/usr/bin/env bash

# fuzzy finder for tmux sessions and project directories

VERSION="1.1.0"

# configuration & paths

CONFIG_FILE_NAME="tmux-sessionizer.conf"
CONFIG_DIR="$HOME/.dotfiles/scripts"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_FILE_NAME"
PANE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-sessionizer"
PANE_CACHE_FILE="$PANE_CACHE_DIR/panes.cache"

[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

# logging

TS_LOG_FILE="${TS_LOG_FILE:-$HOME/.local/share/tmux-sessionizer/tmux-sessionizer.logs}"

log() {
    case "$TS_LOG" in
        "echo") echo "$*" ;;
        "file") mkdir -p "$(dirname "$TS_LOG_FILE")" && echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$TS_LOG_FILE" ;;
    esac
}

# global state

session_idx=""
session_cmd=""
split_type=""
session_args=()
user_selected=""
_TS_FZF_ONLY=""

# help & version

show_help() {
    cat <<EOF
Usage: tmux-sessionizer [OPTIONS] [SEARCH_PATH]

Options:
  -h, --help             Display this help message
  -v, --version          Display version information
  -c, --cmd <name>       Session command name
      -- <args>          Session command arguments
      --vsplit           Create vertical split (horizontal layout) for session command
      --hsplit           Create horizontal split (vertical layout) for session command

Examples:
  tmux-sessionizer                              # Open fuzzy finder
  tmux-sessionizer -c help-fzf                  # Run session command at index 0
  tmux-sessionizer -c btop -- ~/myrepo          # Run session command 2 with args
  tmux-sessionizer -c lazygit --hsplit          # Run with multiple args in hsplit
  tmux-sessionizer ~/projects                   # Open specific directory
EOF
}

show_version() {
    echo "tmux-sessionizer version $VERSION"
}

# argument parsing

parse_arguments() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --)
                shift
                session_args=("$@")
                break
                ;;
            -h | --help)
                show_help
                exit 0
                ;;
            -v | --version)
                show_version
                exit 0
                ;;
            -c | --cmd)
                if [[ -z "$2" || "$2" == -* ]]; then
                    echo "Error: --cmd requires a value" >&2
                    exit 1
                fi
                session_cmd="$2"
                shift
                ;;
            --vsplit)
                split_type="vsplit"
                ;;
            --hsplit)
                split_type="hsplit"
                ;;
            --_fzf-only)
                _TS_FZF_ONLY=1
                ;;
            *)
                user_selected="$1"
                ;;
        esac
        shift
    done

    # Handle session command index resolution
    if [[ -n "$session_cmd" ]]; then
        # Try to find session_cmd in TS_SESSION_COMMANDS array
        local found_idx=""
        for i in "${!TS_SESSION_COMMANDS[@]}"; do
            if [[ "${TS_SESSION_COMMANDS[$i]}" == "$session_cmd" ]]; then
                found_idx="$i"
                break
            fi
        done

        if [[ -n "$found_idx" ]]; then
            # Found in array: use offset TS_OFFSET_IDX + array index
            session_idx=$((TS_SESSION_BASE + found_idx))
        else

            session_idx=$((TS_SESSION_START_IDX + $(ts_hash "$session_cmd") % TS_SESSION_RANGE))
        fi
    fi

    # Validate split options are only used with session commands
    if [[ -n "$split_type" && -z "$session_cmd" ]]; then
        echo "Error: --vsplit and --hsplit can only be used with -s/--session or -c/--cmd option" >&2
        exit 1
    fi

    log "tmux-sessionizer($VERSION): idx=$session_idx cmd=$session_cmd args='${session_args[*]}' split_type=$split_type log=$TS_LOG log_file=$TS_LOG_FILE"
}

# sanity checks

sanity_check() {
    if ! command -v tmux &>/dev/null; then
        echo "Error: tmux is not installed. Please install it first." >&2
        exit 1
    fi

    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is not installed. Please install it first." >&2
        exit 1
    fi
}

# tmux helpers

is_tmux_running() {
    local tmux_running
    tmux_running=$(pgrep tmux)

    if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
        return 1
    fi
    return 0
}

has_session() {
    # NOTE(exact-match): "=" forces literal compare — worktree names "repo [branch]" are regex/pattern metachars.
    tmux has-session -t "=$1" 2>/dev/null
}

tmux_popup() {
    tmux neww -t 404 -n popup -- bash -c "
    clear
    echo \"$1\"
    echo
    echo 'Press any key to close'
    read -n1
  "
}

ts_hash() {
    local s="$1"
    local h=0
    local i c
    for ((i = 0; i < ${#s}; i++)); do
        printf -v c '%d' "'${s:i:1}"
        ((h = (h * 31 + c) & 0x7fffffff))
    done
    echo "$h"
}

switch_to() {
    if [[ -z $TMUX ]]; then
        log "Attaching to session $1"
        tmux attach-session -t "$1"
    else
        log "Switching to session $1"
        tmux switch-client -t "$1"
    fi
}

hydrate() {
    local session_name="$1"
    local selected_path="$2"

    if [[ -n $session_cmd ]]; then
        log "Skipping hydrate for $session_name -- using \"$session_cmd\" instead"
        return
    elif [[ -f "$selected_path/.tmux-sessionizer" ]]; then
        log "Sourcing (local) $selected_path/.tmux-sessionizer"
        tmux send-keys -t "$session_name" "source $selected_path/.tmux-sessionizer" C-m
    elif [[ -f "$HOME/.tmux-sessionizer" ]]; then
        log "Sourcing (global) $HOME/.tmux-sessionizer"
        tmux send-keys -t "$session_name" "source $HOME/.tmux-sessionizer" C-m
    fi
}

# pane cache

init_pane_cache() {
    mkdir -p "$PANE_CACHE_DIR"
    touch "$PANE_CACHE_FILE"
}

get_pane_id() {
    local session_idx="$1"
    local split_type="$2"
    init_pane_cache
    grep "^${session_idx}:${split_type}:" "$PANE_CACHE_FILE" 2>/dev/null | cut -d: -f3
}

set_pane_id() {
    local session_idx="$1"
    local split_type="$2"
    local pane_id="$3"
    init_pane_cache

    # Remove existing entry if it exists
    grep -v "^${session_idx}:${split_type}:" "$PANE_CACHE_FILE" >"${PANE_CACHE_FILE}.tmp" 2>/dev/null || true
    mv "${PANE_CACHE_FILE}.tmp" "$PANE_CACHE_FILE"

    # Add new entry
    echo "${session_idx}:${split_type}:${pane_id}" >>"$PANE_CACHE_FILE"
}

cleanup_dead_panes() {
    init_pane_cache
    local temp_file="${PANE_CACHE_FILE}.tmp"

    while IFS=: read -r idx split pane_id; do
        if tmux list-panes -a -F "#{pane_id}" 2>/dev/null | grep -q "^${pane_id}$"; then
            echo "${idx}:${split}:${pane_id}" >>"$temp_file"
        fi
    done <"$PANE_CACHE_FILE"

    mv "$temp_file" "$PANE_CACHE_FILE" 2>/dev/null || touch "$PANE_CACHE_FILE"
}

# directory search

find_dirs() {
    # Order-preserving dedup: a worktree reachable both via fd and via its bare repo's worktree list
    # would otherwise appear twice. fflush keeps the feed streaming — awk block-buffers a pipe, which
    # would stall fzf until ~4KB accumulated.
    _find_dirs_raw | awk '!seen[$0]++ { print; fflush() }'
}

_find_dirs_raw() {
    # existing tmux session directories
    local -A tmux_dirs
    if command -v tmux >/dev/null 2>&1; then
        while IFS= read -r session_dir; do
            [[ -n "$session_dir" ]] && tmux_dirs["$session_dir"]=1
        done < <(tmux list-sessions -F "#{session_path}" 2>/dev/null)
    fi

    if [[ -n "${TMUX}" ]]; then
        local current_session
        current_session=$(tmux display-message -p '#S')

        tmux list-sessions -F "#{session_last_attached}|[TMUX] #{session_name}" 2>/dev/null |
        sort -t'|' -k1,1nr |
        sed "s/^[^|]*|//" |
        grep -vFx "[TMUX] $current_session"
    fi

    # fd, not ripgrep (rg) - rg has no directory-search mode
    local fd_args=("--type" "d" "--absolute-path" "--color" "never" "--min-depth" "1" "--hidden")

    for ignore in "${TS_IGNORE_PATHS[@]}"; do
        fd_args+=("--exclude" "$ignore")
    done

    {
        printf '%s\n' "/"
        for entry in "${TS_SEARCH_PATHS[@]}"; do
            local path="${entry%%:*}"
            local depth="${entry##*:}"
            [[ "$depth" == "$entry" ]] && depth="${TS_MAX_DEPTH:-1}"

            [[ -d "$path" ]] || continue

            fdfind . "$path" --max-depth "$depth" "${fd_args[@]}" -0 | while IFS= read -r -d '' dir; do

                [[ "$dir" == "/home/" ]] && continue

                local display_path
                if [[ "$dir" == "$HOME/" ]]; then
                    display_path="home"
                else
                    # NOTE(display-norm): drop fd's trailing slash so a worktree found directly by fd and
                    # the same worktree emitted by its bare repo produce one identical row, not two.
                    display_path="${dir/#$HOME/\~}"
                    display_path="${display_path%/}"
                fi

                # NOTE(dedup-key): fd emits a trailing slash, #{session_path} does not — strip after the
                # "$HOME/" / "/home/" comparisons above, which rely on the slashed form.
                local dir_key="${dir%/}"

                # --- Git Detection Logic (Unchanged & Optimized) ---
                # NOTE(git-detect): bare test first — stray .git in a bare repo else shadows worktree expansion.
                if [[ -f "$dir/HEAD" && -d "$dir/objects" ]]; then
                    # Bare repo handling. `detached` worktrees carry no `branch` record — label them
                    # with the short SHA, else they are unreachable from the picker entirely.
                    # The bare repo's own `bare` record is dropped (clears path without printing).
                    local worktree_out
                    worktree_out=$(git -C "$dir" worktree list --porcelain 2>/dev/null | awk '
                    /^worktree / { path = substr($0, 10); sha = ""; next }
                    /^HEAD / { sha = substr($0, 6); next }
                    /^branch / {
                        branch = substr($0, 8)
                        sub(/^refs\/heads\//, "", branch)
                        if (path) { printf "%s [%s]\n", path, branch; path = "" }
                        next
                    }
                    /^detached$/ {
                        if (path) { printf "%s [%s]\n", path, substr(sha, 1, 7); path = "" }
                        next
                    }
                    /^bare$/ { path = "" }
                ')

                    if [[ -z "$worktree_out" ]]; then
                        # HEAD+objects/ heuristic false-positived (not a real repo) — list it as a plain dir.
                        [[ -n "${tmux_dirs[$dir_key]}" ]] || printf '%s\n' "$display_path"
                    else
                        while IFS= read -r worktree_line; do
                            local wt_path="${worktree_line%% \[*}"
                            [[ -z "${tmux_dirs[$wt_path]}" ]] && echo "${worktree_line/#$HOME/\~}"
                        done <<<"$worktree_out"
                    fi

                elif [[ -f "$dir/.git" || -d "$dir/.git" ]]; then
                    [[ -n "${tmux_dirs[$dir_key]}" ]] && continue

                    local git_dir="$dir/.git"
                    if [[ -f "$git_dir" ]]; then
                        local gitdir_line
                        gitdir_line=$(<"$git_dir")
                        git_dir="${gitdir_line#gitdir: }"
                        [[ "$git_dir" != /* ]] && git_dir="$dir/$git_dir"
                    fi

                    local branch=""
                    if [[ -f "$git_dir/HEAD" ]]; then
                        local head_content
                        head_content=$(<"$git_dir/HEAD")
                        if [[ "$head_content" == ref:* ]]; then
                            branch="${head_content#ref: refs/heads/}"
                        else
                            branch="${head_content:0:7}"
                        fi
                    fi

                    if [[ -n "$branch" ]]; then
                        printf '%s [%s]\n' "$display_path" "$branch"
                    else
                        printf '%s\n' "$display_path"
                    fi

                else
                    [[ -n "${tmux_dirs[$dir_key]}" ]] && continue
                    printf '%s\n' "$display_path"
                fi
            done
        done
    }
}

# session command handlers

# NOTE(cmd-quoting): tmux re-parses this string through a shell, so each arg is quoted individually —
# a flat "$*" let an argument containing spaces split into several arguments.
build_full_cmd() {
    local out arg
    out=$(printf '%q' "$session_cmd")
    for arg in "${session_args[@]}"; do
        out+=" $(printf '%q' "$arg")"
    done
    printf '%s' "$out"
}

handle_window_session_cmd() {
    local current_session="$1"

    local target="$current_session:$session_idx"

    local full_cmd
    full_cmd=$(build_full_cmd)

    log "Target: $target, Command: $full_cmd"

    if tmux has-session -t="$target" 2>/dev/null; then
        switch_to "$target"
    else
        log "Creating new window: tmux neww -dt $target $full_cmd"
        tmux neww -dt "$target" "$full_cmd"
        tmux rename-window -t "$target" "$session_cmd"
        # NOTE(hydrate-noop): session_cmd is always set on this path, so hydrate returns early; there is
        # no selected path in scope to pass.
        hydrate "$target" ""
        error=$(tmux select-window -t "$target" 2>&1 >/dev/null)

        if [[ -n $error ]]; then
            log "Error: Failed to open window: $error" >&2
            tmux_popup "⚠️Error: Failed to open window: $error"

        fi
    fi
}

handle_split_session_cmd() {
    local current_session="$1"
    cleanup_dead_panes

    local full_cmd
    full_cmd=$(build_full_cmd)

    # Check if pane already exists
    local existing_pane_id
    existing_pane_id=$(get_pane_id "$session_idx" "$split_type")

    if [[ -n "$existing_pane_id" ]] && tmux list-panes -a -F "#{pane_id}" 2>/dev/null | grep -q "^${existing_pane_id}$"; then
        log "Switching to existing pane $existing_pane_id"
        tmux select-pane -t "$existing_pane_id"
        if [[ -z $TMUX ]]; then
            tmux attach-session -t "$current_session"
        else
            tmux switch-client -t "$current_session"
        fi
    else
        # Create new split
        local split_flag
        if [[ "$split_type" == "vsplit" ]]; then
            split_flag="-h" # Horizontal layout (vertical split)
        else
            split_flag="-v" # Vertical layout (horizontal split)
        fi

        log "Creating new split: tmux split-window $split_flag -c $(pwd) $full_cmd"
        local new_pane_id
        new_pane_id=$(tmux split-window "$split_flag" -c "$(pwd)" -P -F "#{pane_id}" "$full_cmd")

        if [[ -n "$new_pane_id" ]]; then
            set_pane_id "$session_idx" "$split_type" "$new_pane_id"
            log "Created pane $new_pane_id for session_idx=$session_idx split_type=$split_type"
        fi
    fi
}

handle_session_cmd() {
    log "Executing session command: $session_cmd (index: $session_idx, args: '${session_args[*]}', split: $split_type)"

    if ! is_tmux_running; then
        echo "Error: tmux is not running. Please start tmux first before using session commands." >&2
        exit 1
    fi

    if ! command -v "$session_cmd" &>/dev/null; then
        echo "Error: Session command '$session_cmd' is not installed." >&2
        exit 1
    fi

    local current_session
    current_session=$(tmux display-message -p '#S')

    if [[ -n "$split_type" ]]; then
        handle_split_session_cmd "$current_session"
    else
        handle_window_session_cmd "$current_session"
    fi
    exit 0
}

# fuzzy finder

run_fuzzy_finder() {
    # Popup re-invocation: stream find_dirs directly into fzf — no buffering.
    # Outside tmux there is no client for display-popup, so run fzf inline instead.
    if [[ -n "${_TS_RESULT_FILE:-}" || -z "${TMUX:-}" ]]; then
        fzf_preview_script='
    item={}
    if [[ "$item" == \[TMUX\]* ]]; then
        session=$(echo "$item" | sed "s/^\[TMUX\] //" | sed "s/ \[.*\]$//")
        branch=$(echo "$item" | grep -oP "\[\K[^\]]+(?=\]$)" || echo "")
        {
            echo "🖥️  Session: $session"
            [[ -n "$branch" ]] && echo "🌿 Branch: $branch"
            echo "━━━━━━━━━━━━━━━━━━━━━━━"
            echo "Windows:"
            tmux list-windows -t "$session" -F "#I: #W #{?window_active,★, }"
            echo
            echo "Panes:"
            tmux list-panes -t "$session" -F "#I.#P: #{pane_current_command} (#{pane_width}x#{pane_height})"
        } 2>/dev/null | batcat -l yaml --color=always -p
    elif [[ "$item" =~ ^(.+)\ \[([^\]]+)\]$ ]]; then
        dir="${BASH_REMATCH[1]}"
        dir="${dir/#\~/$HOME}"
        branch="${BASH_REMATCH[2]}"
        if [[ -d "$dir" ]]; then
            {
                echo "📁 Directory: $dir"
                echo "🌿 Branch: $branch"
                echo "━━━━━━━━━━━━━━━━━━━━━━━"
                echo
            } | batcat -l yaml --color=always -p
            eza -1 --icons --color=always --group-directories-first "$dir"
        fi
    elif expanded="${item/#\~/$HOME}"; [[ -d "${expanded%/}" ]]; then
        {
            echo "📁 Directory: $item"
            echo "━━━━━━━━━━━━━━━━━━━━━━━"
            echo
        } | batcat -l yaml --color=always -p
        eza -1 --icons --color=always --group-directories-first "$expanded"
    else
        echo "Not a directory or tmux session"
    fi
'

        # 1. Define your specific options in an array
        local my_fzf_options=(
            --cycle
            --tiebreak=index
            --preview "$fzf_preview_script"
            --prompt='❯ '
            --pointer='➤'
            --bind 'ctrl-v:toggle-preview'
            --header ' :Open | ctrl-v:Preview'
            # Theme colors
            --color='bg:-1, bg+:#202020, fg:#abb2bf, fg+:#98c979' # -1 uses terminal's default transparency
            --color='hl:#206a75, hl+:#e06c75, prompt:#61afef, pointer:#e1a51c'
            --color='header:#6ab6bd,info:#c6a642'
        )

        # 2. Execute fzf, clearing the global default opts for just this command
        if [[ -n "${_TS_RESULT_FILE:-}" ]]; then
            find_dirs | FZF_DEFAULT_OPTS='' fzf "${my_fzf_options[@]}" >"$_TS_RESULT_FILE" || true
        else
            find_dirs | FZF_DEFAULT_OPTS='' fzf "${my_fzf_options[@]}" || true
        fi

        return
    fi

    # Parent path: open popup that re-invokes this script in fzf-only mode,
    # then read back the selection from the result file.
    local result_file
    result_file=$(mktemp)

    # NOTE(popup-quoting): $0 may be relative (popup cwd differs) or contain spaces — resolve and %q it
    # before it is re-parsed by the nested `bash -c`.
    # $0 is a bare name when invoked from PATH (tmux.conf run-shell) — resolve via PATH first, then
    # make a relative path absolute.
    local self
    self=$(command -v -- "$0") || self="$0"
    [[ "$self" == /* ]] ||
    self=$(cd -- "$(dirname -- "$self")" && printf '%s/%s' "$(pwd)" "$(basename -- "$self")")

    tmux display-popup -E -w 70% -h 70% \
        "bash -c $(printf '%q' "_TS_RESULT_FILE=$(printf '%q' "$result_file") $(printf '%q' "$self") --_fzf-only")"

    local result
    result=$(cat "$result_file")
    rm -f "$result_file"
    echo "$result"
}

is_worktree() {
    local dir_path="$1"
    local common_dir git_dir
    # NOTE(worktree-detect): common-dir != git-dir is the general test — the old parent-is-bare check
    # missed `git worktree add ../feature`, collapsing same-named worktrees of different repos onto
    # one session name.
    common_dir=$(git -C "$dir_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    git_dir=$(git -C "$dir_path" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
    [[ -n "$common_dir" && "$common_dir" != "$git_dir" ]] || return 1

    # Must be the worktree root: a subdir of a worktree also has git-dir != common-dir, and would
    # otherwise get the root's session name while pointing at the wrong path.
    local top
    top=$(git -C "$dir_path" rev-parse --show-toplevel 2>/dev/null) || return 1
    [[ "$top" == "$(cd -- "$dir_path" && pwd -P)" ]]
}

# main execution
main() {
    sanity_check
    parse_arguments "$@"

    # Set default search paths if not configured
    [[ -n "$TS_SEARCH_PATHS" ]] || TS_SEARCH_PATHS=("$HOME")

    # Add extra search paths if configured
    if [[ ${#TS_EXTRA_SEARCH_PATHS[@]} -gt 0 ]]; then
        TS_SEARCH_PATHS+=("${TS_EXTRA_SEARCH_PATHS[@]}")
    fi

    # Popup re-invocation: just run fzf and exit
    if [[ -n "$_TS_FZF_ONLY" ]]; then
        run_fuzzy_finder
        return
    fi

    # Handle session command if specified
    if [[ -n $session_cmd ]]; then
        handle_session_cmd
        return
    fi

    local raw_input
    local selected_path
    local selected_name

    # 1. Determine Input Source
    if [[ -n "$user_selected" ]]; then
        # Validation: Check if empty OR if NOT (!) a directory
        if [[ -z "$user_selected" ]] || [[ ! -d "$user_selected" ]]; then
            echo "Error: Invalid selection (empty or not a directory)" >&2
            exit 1
        fi
        raw_input="$user_selected"
    else
        raw_input=$(run_fuzzy_finder)
        [[ -z "$raw_input" ]] && exit 0
    fi

    # 2. Handle Existing TMUX Sessions (Early Exit)
    # If the selection is an existing session from the list, just switch to it.
    if [[ "$raw_input" =~ ^\[TMUX\]\ (.+)$ ]]; then
        switch_to "${BASH_REMATCH[1]}"
        return
    fi

    # 3. Extract Path from Input
    # Regex matches: "Path [Branch]" OR just "Path"
    if [[ "$raw_input" =~ ^(.+)\ \[([^\]]+)\]$ ]]; then
        selected_path="${BASH_REMATCH[1]}"
    else
        selected_path="$raw_input"
    fi

    # Expand tilde (~) to $HOME safely
    selected_path="${selected_path/#\~/$HOME}"

    # 4. Generate Session Name (Centralized Logic)
    # We calculate the name here so we don't repeat code for CLI args vs FZF args
    if is_worktree "$selected_path"; then
        local common_dir
        local branch_name
        local parent_name

        # Get git details
        common_dir=$(git -C "$selected_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
        branch_name=$(git -C "$selected_path" branch --show-current 2>/dev/null)
        [[ -n "$branch_name" ]] || branch_name=$(git -C "$selected_path" rev-parse --short HEAD 2>/dev/null)

        # Non-bare repos have common_dir ".../repo/.git" — drop that component, else basename is empty.
        common_dir="${common_dir%/}"
        [[ "$(basename "$common_dir")" == ".git" ]] && common_dir=$(dirname "$common_dir")
        parent_name=$(basename "$common_dir" | sed 's/\.git$//')

        # Format: bare_name [branch]
        selected_name="${parent_name} [${branch_name}]"
    else
        # Regular directory: Normalize name (dots/colons to underscores, lowercase first letter).
        # NOTE(name-sep): tmux parses ":" as session:window, so it must not survive into a session name.
        selected_name=$(basename "$selected_path" | tr '.:' '__' | sed 's/^\(.\)/\L\1/')
    fi

    # 5. Create & Switch
    if ! has_session "$selected_name"; then
        tmux new-session -ds "$selected_name" -c "$selected_path"
        hydrate "$selected_name" "$selected_path"
    fi

    switch_to "$selected_name"
}

# entry point
main "$@"
