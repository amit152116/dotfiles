#!/usr/bin/env bash
# tmux-clip — copy stdin to the system clipboard, resilient to stale
# DISPLAY/WAYLAND_DISPLAY left behind by tmux-resurrect after a reboot.
#
# The tmux server (and panes it restores) can carry environment variables
# captured from a previous login session whose compositor/X server is dead.
# This wrapper resolves the *live* Wayland socket from $XDG_RUNTIME_DIR and
# falls back to xclip on X11, so copy works regardless of stale env.

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Find the active wayland socket (newest non-lock wayland-* entry).
live_wayland=""
for sock in "$runtime_dir"/wayland-*; do
  case "$sock" in
  *.lock | *-renderD*) continue ;;
  esac
  [ -S "$sock" ] && live_wayland="$(basename "$sock")"
done

if [ -n "$live_wayland" ] && command -v wl-copy >/dev/null 2>&1; then
  WAYLAND_DISPLAY="$live_wayland" XDG_RUNTIME_DIR="$runtime_dir" wl-copy
elif command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard -i
else
  echo "tmux-clip: no clipboard backend (wl-copy/xclip) found" >&2
  exit 1
fi
