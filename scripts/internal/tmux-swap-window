#!/usr/bin/env bash
# swaps into an existing window index, or moves the current window there if it's free

target="$1"
if [ -z "$target" ]; then
    echo "Usage: $0 <window-index>"
    exit 1
fi

if tmux list-windows -F "#I" | grep -qx "$target"; then
    tmux swap-window -t "$target"
else
    tmux move-window -t "$target"
fi
