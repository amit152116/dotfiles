#!/usr/bin/env bash

# tmux popup: fzf-select a directory, then open zsh there

VERSION="0.1.0"

# logging

log() {
    case "$PS_LOG" in
        "echo") echo "$*" ;;
        "file")
            local log_file="${PS_LOG_FILE:-$HOME/.local/share/command-runner/command-runner.log}"
            mkdir -p "$(dirname "$log_file")"
            echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$log_file"
            ;;
    esac
}

# help & version

show_help() {
    cat <<EOF
Usage: command-runner [OPTIONS]

Options:
  -h, --help             Display this help message
  -v, --version          Display version information
  -d, --dir <path>       Start search from specific directory
  -p, --prompt <text>    Custom fzf prompt

Examples:
  command-runner                      # Open fzf from default search paths
  command-runner -d ~/projects        # Start from specific directory
  command-runner -p "Select:"         # Custom prompt
EOF
}

show_version() {
    echo "command-runner version $VERSION"
}

# global state

user_search_dir="/"
custom_prompt=""

# argument parsing

parse_arguments() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h | --help)
                show_help
                exit 0
                ;;
            -v | --version)
                show_version
                exit 0
                ;;
            -d | --dir)
                if [[ -z "$2" || "$2" == -* ]]; then
                    echo "Error: --dir requires a path value" >&2
                    exit 1
                fi
                user_search_dir="$2"
                shift
                ;;
            -p | --prompt)
                if [[ -z "$2" || "$2" == -* ]]; then
                    echo "Error: --prompt requires a text value" >&2
                    exit 1
                fi
                custom_prompt="$2"
                shift
                ;;
            --_fzf-only)
                _PS_FZF_ONLY=1
                ;;
            *)
                echo "Error: Unknown option: $1" >&2
                show_help >&2
                exit 1
                ;;
        esac
        shift
    done
}

# sanity checks

sanity_check() {
    if ! command -v tmux &>/dev/null; then
        echo "Error: tmux is not installed. Please install it first." >&2
        exit 1
    fi

    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is not installed. Please install it first." >&2
        exit 1
    fi
}

# directory search

find_dirs() {
    local search_path="${1:-$HOME}"

    local ignored_folders=(
        "node_modules"
        ".git"
        "target"
        "build"
        "dist"
        ".venv"
        "venv"
        "env"
        "__pycache__"
        ".direnv"
        ".cache"
        "root"

        # ros 2 workspaces
        "install" # workspace install dirs
        "log"     # workspace log dirs
        ".clangd" # C++ language server cache

        # linux virtual filesystems - descending into these hangs the search
        "proc"
        "sys"
        "dev"
        "run"

        # heavy system/OS dirs
        "lib"
        "lib32"
        "lib64"
        "libx32"
        "lost+found"
    )

    search_path="${search_path/#\~/$HOME}"
    [[ -d "$search_path" ]] || search_path="$HOME"

    {
        # zoxide first, sorted by frecency
        if command -v zoxide >/dev/null 2>&1; then
            zoxide query --list --score 2>/dev/null |
            sort -rn |
            awk '{print $2}' |
            grep "^$search_path"
        fi

        if command -v fd >/dev/null 2>&1; then
            local fd_args=()
            for folder in "${ignored_folders[@]}"; do
                fd_args+=("--exclude" "$folder")
            done

            fdfind . "$search_path" \
                --min-depth 1 \
                --max-depth 5 \
                --type d \
                --absolute-path \
                --color never \
                "${fd_args[@]}"

        else
            local find_args=()
            for folder in "${ignored_folders[@]}"; do
                find_args+=("-not" "-path" "*/$folder/*")
            done

            find "$search_path" -mindepth 1 -maxdepth 5 -type d \
                "${find_args[@]}" \
                2>/dev/null
        fi
    } |
    while IFS= read -r dir; do
        [[ -d "$dir" ]] || continue
        printf '%s\n' "$dir"
    done |
    awk '!seen[$0]++' | # dedup: fd and zoxide can both list the same path
    while IFS= read -r dir; do
        local display_path
        if [[ "$dir" == "$HOME" ]]; then
            display_path="home"
        else
            display_path="${dir/#$HOME/\~}"
        fi
        printf '%s\n' "$display_path"
    done
}

# main execution

main() {
    sanity_check
    parse_arguments "$@"

    local search_path="${user_search_dir:-$HOME}"

    # Popup re-invocation: just run fzf and write result to file
    if [[ -n "${_PS_FZF_ONLY:-}" ]]; then
        log "Running fzf in popup mode with search path: $search_path"
        local fzf_cmd_opts=(
            --cycle
            --tiebreak=index
            --prompt="${custom_prompt:-> }"
            --pointer='>'
            --marker='+'
            --header 'ctrl-v:Preview | alt-f:Drill dir'
            --color='bg:-1, bg+:#262626, fg:#abb2bf, fg+:#98c979' # -1 uses terminal's default transparency
            --color='hl:#206a75, hl+:#e06c75, prompt:#61afef, pointer:#98d979'
            --color='header:#6ab6bd,info:#c6a642'
            --bind 'ctrl-v:toggle-preview'
            # single-quoted bind body: $HOME and {} must not expand early
            --bind "alt-f:transform:
        selected={}
        expanded=\${selected/#\~/$HOME}
        if [[ -d \"\$expanded\" ]]; then
            echo \"reload(PS_RESULT_FILE=$PS_RESULT_FILE bash $0 --_fzf-only -d \$expanded)+change-prompt(\$selected > )\"
        fi"
            --preview "
        expanded={}
        expanded=\${expanded/#\~/$HOME}
        if [[ -d \"\$expanded\" ]]; then
            eza -1 --icons --color=always --group-directories-first \"\$expanded\" 2>/dev/null || echo '(empty)'
        else
            echo 'Not a directory'
        fi"
        )

        # FZF_DEFAULT_OPTS='' overrides the global default opts so only fzf_cmd_opts apply
        find_dirs "$search_path" | FZF_DEFAULT_OPTS='' fzf "${fzf_cmd_opts[@]}" >"$PS_RESULT_FILE" || true
        exit 0
    fi

    # parent mode: run popup (which re-invokes this script in fzf-only mode), read its result file
    local result_file
    result_file=$(mktemp)

    log "Opening tmux popup with result file: $result_file"

    tmux display-popup -E -w 65% -h 70% \
        "bash -c 'PS_RESULT_FILE=\"${result_file}\" ${0} --_fzf-only -d \"${search_path}\"; exit 0'" || true

    local selected
    selected=$(cat "$result_file" 2>/dev/null)
    rm -f "$result_file"

    if [[ -z "$selected" ]]; then
        log "No selection made"
        return 0
    fi

    local selected_path="${selected/#\~/$HOME}"

    if [[ ! -d "$selected_path" ]]; then
        echo "Error: Selected path is not a directory: $selected_path" >&2
        log "Error: Selected path is not a directory: $selected_path"
        return 1
    fi

    log "Selected path: $selected_path"
    zoxide add "$selected_path" 2>/dev/null || true # update zoxide db
    tmux display-popup -d "$selected_path" -E "zsh"
    exit 0
}

# entry point
main "$@"
