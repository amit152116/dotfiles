#!/bin/bash
session=$(tmux display-message -p '#S' | tr -cd '[:alnum:]_-' 2>/dev/null)
if [ -z "$session" ]; then
    echo ""
    exit 0
fi
overdue=$(task project:"$session" due.before:eod count 2>/dev/null || echo 0)
pending=$(task project:"$session" status:pending count 2>/dev/null || echo 0)
if [ "$overdue" -gt 0 ]; then
    echo " $overdue/$pending"
else
    echo " $pending"
fi
