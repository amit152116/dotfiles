#!/usr/bin/env bash
# detects if pane runs vim/nvim/fzf, mirrors christoomey/vim-tmux-navigator's is_vim check.
# exit 0: vim-like program running (let it handle keypress). exit 1: not vim, tmux should navigate.
#
# usage in tmux.conf:
#   bind-key -n C-h if-shell "tmux-is-vim" "send-keys C-h" "select-pane -L -Z"
set -euo pipefail

ps -o state= -o comm= -t "$(tmux display -p '#{pane_tty}')" \
    | grep -iqE '^[^TXZ ]+ +(\S+/)?g?(view|l?n?vim?x?|fzf)(diff)?$'
