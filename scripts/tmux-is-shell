#!/usr/bin/env bash
# detects whether the tmux pane is at a shell prompt or running a program (nvim, less, etc.),
# since pane_current_command still reports "zsh" for a program launched from inside a shell.
# exit 0: at a shell prompt. exit 1: program running.
#
# usage in tmux.conf:
#   bind-key -T root M-y if-shell "tmux-is-shell" \
#       "send-keys M-y" \
#       "new-window 'tmux-sessionizer -c yazi'"

set -euo pipefail

PANE_CMD=$(tmux display -p '#{pane_current_command}')
PANE_PID=$(tmux display -p '#{pane_pid}')

SHELL_PATTERN='^(-|)(zsh|bash|sh|fish|dash|ksh|tcsh|csh|su|login)$'

if ! echo "$PANE_CMD" | grep -qE "$SHELL_PATTERN"; then
    exit 1
fi

# '+' in STAT = foreground process group -> shell has a foreground child running
CHILDREN_STATS=$(ps -o stat= --ppid "$PANE_PID" 2>/dev/null || echo "")

if [[ -n "$CHILDREN_STATS" ]] && echo "$CHILDREN_STATS" | grep -q '+'; then
    exit 1
fi

exit 0
