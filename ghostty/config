# Ghostty Configuration - Alacritty-compatible setup
# Generated from ~/.dotfiles/alacritty/alacritty.toml

#=============================================================================
# FONT
#=============================================================================
font-family = "JetBrainsMonoNL Nerd Font"
font-size = 15

#=============================================================================
# WINDOW
#=============================================================================
# Opacity (0.0 = transparent, 1.0 = opaque)
background-opacity = 0.90

# Window decorations (none, auto, client, server)
window-decoration = auto

# Dynamic title is handled automatically via shell integration.
# Keep shell integration enabled to show running commands in the titlebar.

# Start maximized on launch
maximize = true
# fullscreen = true

# Dynamic padding (aligns with Alacritty's dynamic_padding)
# Ghostty uses window-padding-x/y for similar behavior
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-save-state = always

# Titlebar (macOS specific)
window-subtitle = false

#=============================================================================
# CURSOR
#=============================================================================
# Cursor style: block, bar, underline, block_hollow
cursor-style = block

# Blink state
cursor-style-blink = false

# Cursor color (named color or #RRGGBB format)
cursor-color = #D0CFCC
cursor-invert-fg-bg = false
cursor-opacity = 1.0

#=============================================================================
# SCROLLING
#=============================================================================
# Mouse scroll multiplier (Alacritty uses multiplier = 3)
mouse-scroll-multiplier = 3

# Scrollback buffer size
scrollback-limit = 10000000

#=============================================================================
# SELECTION
#=============================================================================
# Invert selection colors
selection-invert-fg-bg = true

# Selection colors
selection-background = #3a3f5a
selection-foreground = #D0CFCC

#=============================================================================
# MOUSE
#=============================================================================
# Hide mouse when typing
mouse-hide-while-typing = true

# Click to move cursor
cursor-click-to-move = true

#=============================================================================
# COLORS (Dracula-inspired palette from Alacritty)
#=============================================================================
# Background and foreground
background = #010100
foreground = #D0CFCC

#=============================================================================
# KEYBINDINGS (commonly used)
#=============================================================================
# Clipboard operations
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = shift+insert=paste_from_selection

# Window management
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+shift+q=quit

# Tab navigation
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+alt+left=previous_tab
keybind = ctrl+alt+right=next_tab

# Reload config
keybind = ctrl+shift+comma=reload_config

# Inspector (debugging)
keybind = ctrl+shift+i=inspector:toggle

#=============================================================================
# OTHER SETTINGS
#=============================================================================
# Use sRGB color space for terminal colors
window-colorspace = srgb

# Window theme (auto, system, light, dark, ghostty)
window-theme = auto

# VSync (minimize tearing, may increase input latency)
window-vsync = true

# Inherit working directory and font size for new windows
window-inherit-working-directory = true
window-inherit-font-size = true

# Alpha blending (native for Linux = sRGB)
alpha-blending = native
